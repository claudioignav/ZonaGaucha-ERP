{
  "name": "zonagaucha-backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test:ci": "jest --runInBand --coverage",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "express": "^5.2.1",
    "dotenv": "^16.6.1",
    "sequelize": "^6.37.8",
    "tedious": "^19.2.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "restoreMocks": true,
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "index.js",
      "app.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js",
      "config/**/*.js",
      "models/**/*.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80,
        "branches": 80
      }
    }
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    },
    "tedious": {
      "@azure/identity": "4.13.0",
      "@azure/msal-node": {
        "uuid": "11.1.1"
      }
    }
  }
}
