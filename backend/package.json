{
  "name": "zonagaucha-backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "test:ci": "c8 node --test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "c8": {
    "all": true,
    "extension": [".js"],
    "exclude": ["node_modules/**", "coverage/**", "tests/**"],
    "reporter": ["text", "lcov"],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  }
}
